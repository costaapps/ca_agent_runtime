PORT=3101
NODE_ENV=development

OPENAI_MODEL=
OPENAI_TRACING_ENABLED=true
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false

MCP_SERVER_URL=http://localhost:3102/mcp
MCP_TIMEOUT_MS=30000

CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=3306
CENTRAL_DB_NAME=
CENTRAL_DB_USER=
CENTRAL_DB_PASS=
CENTRAL_DB_CONNECTION_LIMIT=4
CENTRAL_REGISTRY_CACHE_MS=60000

# Non-empty JSON allowlist of tenant CompanyUUIDs enabled in this Runtime.
AGENT_RUNTIME_TENANT_ALLOWLIST=["00000000-0000-4000-8000-000000000001"]
TENANT_DB_CONNECTION_LIMIT=8
TENANT_DB_MAX_POOLS=32
TENANT_DB_IDLE_TIMEOUT_MS=300000
AGENT_RUNTIME_DRAIN_TIMEOUT_MS=120000

# Set only for the administrative migration command.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
